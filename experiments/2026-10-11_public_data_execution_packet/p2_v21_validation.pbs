#!/bin/zsh
#PBS -N p2v21_V2V3
#PBS -q default
#PBS -l select=1:ncpus=20:ngpus=1:mem=60gb:host=yayoi42
#PBS -l walltime=04:00:00
#PBS -j oe
# Prep protocol v2.1 validation V2 + V3 (docs/PUBLIC_DATA_PREP_V2_MODELLER_DESIGN.md §6, §11) on yayoi40 (RTX 5080).
#   V2: prep (C2; already done on 183, skipped) + setup (C3) for 8 samples x v21m1, v21m2
#   V3: rep01, 1 ns + strip (C4) for all 16 models
# All work is done by p2_v21_validation.sh (bash, set -euo pipefail); its log is
# p2_v21_validation.log in this directory.  Resumable: qsub this file again.
# Walltime: on the 5090 (v1) one model's NVT+NPT+1 ns took ~3.5 min; on yayoi40 the
# 5080 ran one setup in 10 s (2026-10-14), MD speed on the 5080 not measured yet.
#
#   cd /home/ruigengji/JAXPBSA/experiments/2026-10-11_public_data_execution_packet
#   qsub p2_v21_validation.pbs

test $PBS_O_WORKDIR && cd $PBS_O_WORKDIR
. /home/apps/Modules/init/profile.sh
export MODULEPATH=/home/ruigengji/modulefiles:$MODULEPATH

export MAMBA_EXE=/home/ruigengji/miniforge3/bin/mamba
export MAMBA_ROOT_PREFIX=/home/ruigengji/miniforge3
source /home/ruigengji/miniforge3/etc/profile.d/mamba.sh
mamba activate openmm_dev

P=/home/ruigengji/JAXPBSA/experiments/2026-10-11_public_data_execution_packet
# 9950X3D: 16 physical cores; OpenMM runs on the GPU, threads only matter for prep/strip.
export OMP_NUM_THREADS=16 MKL_NUM_THREADS=16
# One GPU is allocated, so device index 0 is that GPU.
PY="$(command -v python)" DEV=0 PROD_NS=1 REPS="01" bash $P/p2_v21_validation.sh
