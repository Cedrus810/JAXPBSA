+def _npb_setup(surface="binary"):
+    from jaxpbsa.pb.grid import GridSpec
+    X, R = _gap_cluster()
+    q = np.array([0.6, -0.4, 0.5, -0.3, 0.4])  # 净 +0.8
+    g = GridSpec(origin=(-11.0, -11.0, -11.0), shape=(45, 45, 45), h=0.5)
+    return X, R, q, g
